# Copy to .env (never commit .env) and replace every "change-me".
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Fernet key:            python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# Interface the web UIs / Postgres listen on. 127.0.0.1 = this machine only.
# Set to the server's Tailscale IP to reach them from your other devices (never 0.0.0.0 on a shared network).
BIND_ADDR=127.0.0.1

# Linux user id that owns the repo checkout (run `id -u`)
AIRFLOW_UID=1000

AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

POSTGRES_SUPERUSER_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
WAREHOUSE_DB_PASSWORD=change-me

# S3-compatible data lake (RustFS)
LAKE_ACCESS_KEY=lakeadmin
LAKE_SECRET_KEY=change-me

SPARK_WORKER_MEMORY=2g
