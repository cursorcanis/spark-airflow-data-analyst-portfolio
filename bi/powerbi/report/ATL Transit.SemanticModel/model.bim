              "expression": [
                "let",
                "    Source = PostgreSQL.Database(PgServer, \"warehouse\"),",
                "    Data = Source{[Schema = \"marts\", Item = \"mart_h3_bus_speed\"]}[Data],",
                "    Kept = Table.SelectColumns(Data, {\"h3_cell\", \"gps_fixes\", \"routes\", \"speed_samples\", \"pct_stopped\", \"median_moving_speed_kmh\", \"peak_median_moving_speed_kmh\", \"stops_observed\", \"arrivals_observed\", \"pct_on_time\"})",
                "in",
                "    Kept"
              ]
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Measures",
            "dataType": "string",
            "sourceColumn": "Measures",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Measures = text], {})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Arrivals",
            "expression": "COUNTROWS ( fct_stop_arrival )",
            "formatString": "#,0"
          },
          {
            "name": "On-time %",
            "expression": "DIVIDE (\n    CALCULATE ( [Arrivals], fct_stop_arrival[is_on_time] = TRUE () ),\n    [Arrivals]\n)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Late %",
            "expression": "DIVIDE ( CALCULATE ( [Arrivals], fct_stop_arrival[is_late] = TRUE () ), [Arrivals] )",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Early %",
            "expression": "DIVIDE ( CALCULATE ( [Arrivals], fct_stop_arrival[is_early] = TRUE () ), [Arrivals] )",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Median delay (min)",
            "expression": "MEDIAN ( fct_stop_arrival[delay_min] )",
            "formatString": "0.0"
          },
          {
            "name": "P90 delay (min)",
            "expression": "PERCENTILE.INC ( fct_stop_arrival[delay_min], 0.9 )",
            "formatString": "0.0"
          },
          {
            "name": "On-time % vs network",
            "expression": "[On-time %] - CALCULATE ( [On-time %], REMOVEFILTERS ( dim_route ) )",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "On-time % (7-day)",
            "expression": "CALCULATE (\n    [On-time %],\n    DATESINPERIOD ( dim_date[date_day], MAX ( dim_date[date_day] ), -7, DAY )\n)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Routes below 60%",
            "expression": "COUNTROWS ( FILTER ( VALUES ( dim_route[route_id] ), [On-time %] < 0.6 ) )",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "GPS-checked on-time %",
            "expression": "DIVIDE (\n    CALCULATE ( SUM ( mart_gps_validation[arrivals] ), mart_gps_validation[gps_class] = \"on_time\" ),\n    CALCULATE ( SUM ( mart_gps_validation[arrivals] ), mart_gps_validation[gps_class] <> \"not_confirmed\" )\n)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "GPS confirmed %",
            "expression": "DIVIDE (\n    CALCULATE ( SUM ( mart_gps_validation[arrivals] ), mart_gps_validation[gps_class] <> \"not_confirmed\" ),\n    SUM ( mart_gps_validation[arrivals] )\n)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "On-time % (routes 300+)",
            "expression": "IF ( [Arrivals] >= 300, [On-time %] )",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "On-time % (stops 50+)",
            "expression": "IF ( [Arrivals] >= 50, [On-time %] )",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Not on time % (stops 50+)",
            "expression": "IF ( [Arrivals] >= 50, 1 - [On-time %] )",
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "fct_stop_arrival_route_id__dim_route_route_id",
        "fromTable": "fct_stop_arrival",
        "fromColumn": "route_id",
        "toTable": "dim_route",
        "toColumn": "route_id"
      },
      {
        "name": "fct_stop_arrival_stop_id__dim_stop_stop_id",
        "fromTable": "fct_stop_arrival",
        "fromColumn": "stop_id",
        "toTable": "dim_stop",
        "toColumn": "stop_id"
      },
      {
        "name": "fct_stop_arrival_service_date__dim_date_date_day",
        "fromTable": "fct_stop_arrival",
        "fromColumn": "service_date",
        "toTable": "dim_date",
        "toColumn": "date_day"
      },
      {
        "name": "dim_stop_tract_geoid__dim_tract_geoid",
        "fromTable": "dim_stop",
        "fromColumn": "tract_geoid",
        "toTable": "dim_tract",
        "toColumn": "geoid"
      }
    ],
    "expressions": [
      {
        "name": "PgServer",
        "kind": "m",
        "expression": "\"YOUR-SERVER:5432\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"PgServer\", \"dim_date\", \"dim_route\", \"dim_stop\", \"dim_tract\", \"fct_stop_arrival\", \"mart_route_on_time_daily\", \"mart_on_time_by_hour\", \"mart_tract_service_equity\", \"mart_gps_validation\", \"mart_h3_bus_speed\", \"_Measures\"]"
      },
      {
        "name": "PBIDesktopVersion",
        "value": "2.160"
      }
    ]
  }
}
